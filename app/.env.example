# Copy to `.env` or `.env.txt` in this folder. Never commit real secrets.

# --- AI backends ---
AI_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
# If using Ollama Cloud (OLLAMA_HOST=https://ollama.com), set:
# OLLAMA_API_KEY=

# Optional: use OpenAI instead of Ollama
# AI_BACKEND=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional (TOOL2-style): Dashboard “Chart trends — AI summary” Ollama multi-agent + tools + RAG
# (Insight → Validator QC + footer are automatic whenever orchestrator runs with a non-empty draft.)
# DASHBOARD_AI_ORCHESTRATOR=1
# Parallel Data + RAG Ollama rounds (default on). Set 0 if a single Ollama worker serializes anyway and you want simpler logs:
# DASHBOARD_AI_ORCH_PARALLEL=0

# --- openFDA (optional) ---
# OPENFDA_API_KEY=

# --- Posit Connect (used by deployme.sh / manifestme.sh) ---
# CONNECT_SERVER=https://connect.your-company.com
# CONNECT_API_KEY=
# Optional:
# CONNECT_TITLE=drugsfda-explorer
# CONNECT_PYTHON_VERSION=3.12.4
